# ─── Flutter Client ───
# Razorpay payment gateway credentials
RAZORPAY_KEY=
RAZORPAY_SECRET=

# AdMob App IDs (use Google test IDs for development)
# Production IDs are set via CI secrets — never commit real ones here.
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713

# ─── Firebase Emulator Configuration ───
# Set these to "true" to use local emulators during development.
USE_AUTH_EMULATOR=false
USE_FIRESTORE_EMULATOR=false
USE_FUNCTIONS_EMULATOR=false
FIREBASE_EMULATOR_HOST=127.0.0.1
AUTH_EMULATOR_PORT=9099
FIRESTORE_EMULATOR_PORT=8080
FUNCTIONS_EMULATOR_PORT=5001

# ─── Cloud Functions ───
# Set in functions/.env (not committed)
# RAZORPAY_KEY_ID_TEST=
# RAZORPAY_KEY_SECRET_TEST=
# RAZORPAY_KEY_ID_LIVE=
# RAZORPAY_KEY_SECRET_LIVE=
# RAZORPAY_MODE=test
