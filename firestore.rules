rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function currentRole() {
      return (request.auth.token.role is string && request.auth.token.role != '')
        ? request.auth.token.role
        : (
          userDoc(currentUid()).exists
          && ('role' in userDoc(currentUid()).data)
          && userDoc(currentUid()).data.role is string
            ? userDoc(currentUid()).data.role
            : null
        );
    }

    function isOwner() {
      return isAuthenticated() && currentRole() == 'owner';
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          request.auth.token.admin == true
          || currentRole() == 'admin'
        );
    }

    function isOwnerOrLegacySelf(ownerId) {
      return isAuthenticated()
        && ownerId == currentUid()
        && (
          currentRole() == 'owner'
          || !userDoc(currentUid()).exists
          || !('role' in userDoc(currentUid()).data)
        );
    }

    function isTenant() {
      return isAuthenticated() && currentRole() == 'tenant';
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function tenantPropertyId(uid) {
      return exists(/databases/$(database)/documents/tenants/$(uid))
        ? get(/databases/$(database)/documents/tenants/$(uid)).data.propertyId
        : null;
    }

    function roleIsValid(role) {
      return role in ['owner', 'tenant'];
    }

    function userRoleUnchanged() {
      return (('role' in resource.data) && request.resource.data.role == resource.data.role)
        || (!('role' in resource.data)
          && request.resource.data.role == 'tenant');
    }

    function userUidUnchanged() {
      return (('uid' in resource.data) && request.resource.data.uid == resource.data.uid)
        || (!('uid' in resource.data)
          && request.resource.data.uid == currentUid());
    }

    function safeUserProfileFieldsOnly(data) {
      return data.keys().hasOnly([
        'uid',
        'role',
        'name',
        'email',
        'phone',
        'photoUrl',
        'createdAt',
        'updatedAt',
        'notifications',
        'notificationsEnabled',
        'darkMode',
        'fcmToken',
        'fcmTokenUpdatedAt',
      ]);
    }

    function safePublicProfileFieldsOnly(data) {
      return data.keys().hasOnly([
        'name',
        'phone_optional',
        'rating',
        'profileImage',
        'updatedAt',
      ]);
    }

    function publicProfileShapeIsValid(data) {
      return safePublicProfileFieldsOnly(data)
        && (!('name' in data) || data.name is string)
        && (!('phone_optional' in data) || data.phone_optional is string)
        && (!('rating' in data) || data.rating is number)
        && (!('profileImage' in data) || data.profileImage is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function notificationsShapeIsValid(data) {
      return !('notifications' in data)
        || (
          data.notifications is map
          && (!('rent_due' in data.notifications) || data.notifications.rent_due is bool)
          && (!('payment_received' in data.notifications)
            || data.notifications.payment_received is bool)
        );
    }

    function tokenPlatformIsValid(platform) {
      return platform in ['android', 'ios', 'web', 'unknown'];
    }

    function deviceTokenShapeIsValid(data) {
      return data.token is string
        && data.token.size() > 20
        && data.token.size() < 4096
        && data.platform is string
        && tokenPlatformIsValid(data.platform)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('lastUsedAt' in data) || data.lastUsedAt is timestamp);
    }

    function ownerOwnsProperty(propertyId) {
      return exists(/databases/$(database)/documents/properties/$(propertyId))
        && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == currentUid();
    }

    function ownerDoc(uid) {
      return get(/databases/$(database)/documents/owners/$(uid));
    }

    function ownerTenantLimit(uid) {
      return ownerDoc(uid).exists && ('tenantLimit' in ownerDoc(uid).data)
        ? ownerDoc(uid).data.tenantLimit
        : 2;
    }

    function ownerCurrentTenantCount(uid) {
      return ownerDoc(uid).exists && ('currentTenantCount' in ownerDoc(uid).data)
        ? ownerDoc(uid).data.currentTenantCount
        : 0;
    }

    function ownerPaymentStatus(uid) {
      return ownerDoc(uid).exists && ('paymentStatus' in ownerDoc(uid).data)
        ? ownerDoc(uid).data.paymentStatus
        : 'active';
    }

    function ownerCanCreateTenant(uid) {
      return ownerPaymentStatus(uid) != 'pending'
        && ownerCurrentTenantCount(uid) < ownerTenantLimit(uid);
    }

    function isTenantOfOwner(ownerId) {
      return isTenant()
        && exists(/databases/$(database)/documents/tenants/$(currentUid()))
        && get(/databases/$(database)/documents/tenants/$(currentUid())).data.ownerId == ownerId;
    }

    function tenantOwnerImmutableFieldsUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.fullName == resource.data.fullName
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.email == resource.data.email
        && request.resource.data.idProofType == resource.data.idProofType
        && request.resource.data.idProofUrl == resource.data.idProofUrl
        && request.resource.data.agreementUrl == resource.data.agreementUrl
        && request.resource.data.additionalDocumentUrls == resource.data.additionalDocumentUrls;
    }

    function tenantTrustFieldsUnchanged() {
      return (
        (('trustScore' in resource.data) && request.resource.data.trustScore == resource.data.trustScore)
          || (!('trustScore' in resource.data) && !('trustScore' in request.resource.data))
      )
      && (
        (('trustBadge' in resource.data) && request.resource.data.trustBadge == resource.data.trustBadge)
          || (!('trustBadge' in resource.data) && !('trustBadge' in request.resource.data))
      );
    }

    function tenantOwnsDocByIdOrEmail(tenantId, tenantData) {
      return isTenant() && (
        tenantId == currentUid()
        || (('authUid' in tenantData) && tenantData.authUid == currentUid())
        || (('email' in tenantData) && tenantData.email == request.auth.token.email)
      );
    }

    function tenantCanSelfCreateProfile(tenantId) {
      return isTenant()
        && tenantId == currentUid()
        && request.resource.data.authUid == currentUid()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailLowercase is string
        && request.resource.data.name is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.ownerId == ''
        && request.resource.data.roomNumber is string
        && request.resource.data.dueAmount == 0
        && request.resource.data.totalPaid == 0
        && request.resource.data.isActive == false
        && request.resource.data.onboardingStatus == 'pending_assignment';
    }

    function tenantParentData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }

    function ownerCanAccessTenantByParent(tenantId) {
      return isOwner() && (
        tenantParentData(tenantId).ownerId == currentUid()
        || (
          ('propertyId' in tenantParentData(tenantId))
          && ownerOwnsProperty(tenantParentData(tenantId).propertyId)
        )
      );
    }

    function validIndianPhone(value) {
      return value is string
        && value.matches('^[6-9][0-9]{9}$');
    }

    function isPhoneKeyedTenantDoc(tenantId) {
      return tenantId is string
        && tenantId.matches('^\\+91[6-9][0-9]{9}$');
    }

    function validPaymentMethod(method) {
      return method in ['UPI', 'Cash', 'Bank Transfer', 'Razorpay', 'Credit Card', 'online'];
    }

    function validPaymentStatus(status) {
      return status in ['paid', 'partial', 'unpaid', 'pending', 'success'];
    }

    function validPaymentAmount(amount) {
      return amount is int && amount > 0 && amount <= 5000000;
    }

    function paymentFieldsLookValid(data) {
      return validPaymentAmount(data.amount)
        && validPaymentMethod(data.method)
        && validPaymentStatus(data.status)
        && (!('paidAmount' in data) || (data.paidAmount is int && data.paidAmount >= 0 && data.paidAmount <= data.amount))
        && (!('baseAmount' in data) || (data.baseAmount is int && data.baseAmount >= 0 && data.baseAmount <= 5000000))
        && (!('remainingAmount' in data) || (data.remainingAmount is int && data.remainingAmount >= 0 && data.remainingAmount <= data.amount))
        && (!('month' in data) || (data.month is int && data.month >= 1 && data.month <= 12))
        && (!('year' in data) || (data.year is int && data.year >= 2020 && data.year <= 2100))
        && (!('paymentMonth' in data) || (data.paymentMonth is string && data.paymentMonth.matches('^[0-9]{4}-[0-9]{2}$')));
    }

    // ===== FIRESTORE RULES =====

    match /users/{userId} {
      allow get: if isAuthenticated() && userId == currentUid();
      allow list: if false;

      allow create: if isAuthenticated()
        && userId == currentUid()
        && request.resource.data.uid == currentUid()
        && roleIsValid(request.resource.data.role)
        && safeUserProfileFieldsOnly(request.resource.data)
        && notificationsShapeIsValid(request.resource.data);

      allow update: if isAuthenticated()
        && userId == currentUid()
        && roleIsValid(request.resource.data.role)
        && userUidUnchanged()
        && userRoleUnchanged()
        && safeUserProfileFieldsOnly(request.resource.data)
        && notificationsShapeIsValid(request.resource.data);

      allow delete: if false;

      match /deviceTokens/{tokenId} {
        allow read: if isAuthenticated() && userId == currentUid();

        allow create: if isAuthenticated()
          && userId == currentUid()
          && deviceTokenShapeIsValid(request.resource.data);

        allow update: if isAuthenticated()
          && userId == currentUid()
          && deviceTokenShapeIsValid(request.resource.data)
          && request.resource.data.token == resource.data.token;

        allow delete: if isAuthenticated() && userId == currentUid();
      }

      match /notificationSnoozes/{snoozeId} {
        allow read, create, update, delete: if isAuthenticated() && userId == currentUid();
      }
    }

    match /publicProfiles/{userId} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create, update: if isAuthenticated()
        && userId == currentUid()
        && publicProfileShapeIsValid(request.resource.data);

      allow delete: if false;
    }

    match /ownerPaymentProfiles/{ownerId} {
      allow read, write: if isOwnerOrLegacySelf(ownerId);
    }

    match /owners/{ownerId} {
      allow read: if isOwnerOrLegacySelf(ownerId);

      allow create: if isOwnerOrLegacySelf(ownerId)
        && request.resource.data.ownerId == currentUid();

      allow update: if isOwnerOrLegacySelf(ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.currentTenantCount is int
        && request.resource.data.tenantLimit is int
        && request.resource.data.tenantLimit >= 2;

      allow delete: if false;
    }

    match /owners_summary/{ownerId} {
      allow read: if isOwnerOrLegacySelf(ownerId);

      allow create, update, delete: if false;
    }

    match /ownerTrustScoreLookupQuota/{docId} {
      allow read: if isOwner() && resource.data.ownerId == currentUid();
      allow create, update, delete: if false;
    }

    match /ownerTrustScoreLookupEvents/{eventId} {
      allow read: if isOwner() && resource.data.ownerId == currentUid();
      allow create, update, delete: if false;
    }

    match /tenantTrust/{phone} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    match /properties/{propertyId} {
      allow read: if (isOwner() && resource.data.ownerId == currentUid())
        || (isTenant() && (
          tenantPropertyId(currentUid()) == propertyId
          || (('isPublished' in resource.data) && resource.data.isPublished == true)
        ));

      allow create: if isOwner()
        && isVerified()
        && request.resource.data.ownerId == currentUid();

      allow update: if isOwner()
        && isVerified()
        && resource.data.ownerId == currentUid()
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isOwner()
        && isVerified()
        && resource.data.ownerId == currentUid();
    }

    match /tenants/{tenantId} {
      allow read: if (isOwner() && (
          resource.data.ownerId == currentUid()
          || (
            ('propertyId' in resource.data)
            && ownerOwnsProperty(resource.data.propertyId)
          )
        ))
        || tenantOwnsDocByIdOrEmail(tenantId, resource.data);

      allow create: if (
          isOwner()
          && isVerified()
          && request.resource.data.ownerId == currentUid()
          && ownerCanCreateTenant(currentUid())
          && ownerOwnsProperty(request.resource.data.propertyId)
        )
        || (tenantCanSelfCreateProfile(tenantId) && isVerified());

      allow update: if (
          isOwner()
          && isVerified()
          && resource.data.ownerId == currentUid()
          && request.resource.data.ownerId == resource.data.ownerId
          && ownerOwnsProperty(request.resource.data.propertyId)
          && tenantOwnerImmutableFieldsUnchanged()
          && tenantTrustFieldsUnchanged()
        )
        || (
          tenantOwnsDocByIdOrEmail(tenantId, resource.data)
          && isVerified()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.email == resource.data.email
          && request.resource.data.authUid == resource.data.authUid
        );

      allow delete: if isOwner() && isVerified() && (
        resource.data.ownerId == currentUid()
        || (
          ('propertyId' in resource.data)
          && ownerOwnsProperty(resource.data.propertyId)
        )
      );
    }

    match /tenants/{tenantId}/payments/{paymentId} {
      allow read: if ownerCanAccessTenantByParent(tenantId)
        || tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId));

      // Legacy tenant subcollection payment writes are disabled.
      // Payments must be written by Cloud Functions (Admin SDK).
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/room_details/{docId} {
      allow read: if ownerCanAccessTenantByParent(tenantId)
        || tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId));

      allow create, update: if tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId))
        && docId == 'current'
        && request.resource.data.propertyName is string
        && request.resource.data.roomNumber is string
        && request.resource.data.monthlyRent is int
        && request.resource.data.monthlyRent > 0
        && request.resource.data.rentDueDay is int
        && request.resource.data.rentDueDay >= 1
        && request.resource.data.rentDueDay <= 31;

      allow delete: if false;
    }

    match /tenants/{tenantId}/owner_details/{docId} {
      allow read: if ownerCanAccessTenantByParent(tenantId)
        || tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId));

      allow create, update: if tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId))
        && docId == 'current'
        && validIndianPhone(request.resource.data.ownerPhoneNumber);

      allow delete: if false;
    }

    match /tenants/{tenantId}/reminders/{reminderId} {
      allow read: if ownerCanAccessTenantByParent(tenantId)
        || tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId));

      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/documents/{docId} {
      allow read: if tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId));

      allow create: if tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId))
        && request.resource.data.fileUrl is string
        && request.resource.data.publicId is string
        && request.resource.data.fileType in ['image', 'pdf']
        && request.resource.data.fileSizeBytes is int
        && (
          (request.resource.data.fileType == 'image' && request.resource.data.fileSizeBytes <= 200 * 1024)
          ||
          (request.resource.data.fileType == 'pdf' && request.resource.data.fileSizeBytes <= 500 * 1024)
        );

      allow update: if tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId))
        && request.resource.data.fileUrl == resource.data.fileUrl
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.fileType == resource.data.fileType
        && request.resource.data.fileSizeBytes == resource.data.fileSizeBytes;

      allow delete: if tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId));
    }

    match /tenants/{tenantId}/complaints/{complaintId} {
      allow read: if ownerCanAccessTenantByParent(tenantId)
        || tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId));

      allow create: if tenantOwnsDocByIdOrEmail(tenantId, tenantParentData(tenantId))
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.status in ['pending', 'resolved'];

      allow update: if ownerCanAccessTenantByParent(tenantId)
        && request.resource.data.description == resource.data.description
        && request.resource.data.category == resource.data.category
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.status in ['pending', 'resolved'];

      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if (isOwner() && resource.data.ownerId == currentUid())
        || (isTenant() && resource.data.tenantId == currentUid());

      // Payment writes are server-only via Cloud Functions (Admin SDK bypasses rules).
      allow create, update, delete: if false;
    }

    match /appConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() && adminId == currentUid();
      allow write: if false;
    }

    match /user_images/{imageId} {
      allow read: if isAuthenticated() && resource.data.userId == currentUid();

      allow create: if isAuthenticated()
        && request.resource.data.userId == currentUid()
        && request.resource.data.imageUrl is string
        && request.resource.data.uploadedAt is timestamp;

      allow update: if isAuthenticated()
        && resource.data.userId == currentUid()
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isAuthenticated() && resource.data.userId == currentUid();
    }

    match /transactions/{transactionId} {
      allow read: if (isOwner() && resource.data.ownerId == currentUid())
        || (isTenant() && resource.data.tenantId == currentUid());
      allow write: if false;
    }

    match /leases/{leaseId} {
      allow read: if (isOwner() && resource.data.ownerId == currentUid())
        || (isTenant() && resource.data.tenantId == currentUid());
      allow write: if false;
    }

    match /messages/{messageId} {
      allow read: if (isOwner() && resource.data.ownerId == currentUid())
        || (isTenant() && resource.data.tenantId == currentUid());
      allow write: if false;
    }

    match /fcmTokens/{tokenId} {
      allow read, write: if false;
    }

    match /_webhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /_securitySignals/{signalId} {
      allow read, write: if false;
    }

    match /_securityAlerts/{alertId} {
      allow read, write: if false;
    }

    match /_notificationEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}