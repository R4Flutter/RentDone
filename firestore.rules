rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isAuth() && userId == uid();
    }

    match /properties/{propertyId} {
      allow read: if isAuth() && (
        resource.data.ownerId == uid() ||
        (get(/databases/$(database)/documents/tenants/$(uid())).data.propertyId == propertyId)
      );

      allow create: if isAuth()
        && request.resource.data.ownerId == uid();

      allow update, delete: if isAuth()
        && resource.data.ownerId == uid();
    }

    match /tenants/{tenantId} {

      allow read: if isAuth() && (
        tenantId == uid() ||
        resource.data.ownerId == uid()
      );

      allow create: if isAuth()
        && request.resource.data.ownerId == uid();

      allow update: if isAuth() && (
        tenantId == uid() ||
        resource.data.ownerId == uid()
      );

      allow delete: if isAuth()
        && resource.data.ownerId == uid();

      match /payments/{paymentId} {
        allow read: if isAuth();

        allow create: if isAuth()
          && request.resource.data.amount is int
          && request.resource.data.amount > 0;

        allow update, delete: if isAuth();
      }
    }

    match /payments/{paymentId} {
      allow read: if isAuth() && (
        resource.data.ownerId == uid() ||
        resource.data.tenantId == uid()
      );

      allow create: if isAuth()
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && 'ownerId' in request.resource.data
        && 'tenantId' in request.resource.data;

      allow update: if isAuth() && (
        resource.data.ownerId == uid() ||
        resource.data.tenantId == uid()
      );

      allow delete: if isAuth() && resource.data.ownerId == uid();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}