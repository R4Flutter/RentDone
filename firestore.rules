rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function currentRole() {
      return request.auth.token.get('role', '');
    }

    function isOwner() {
      return isAuthenticated() && (
        currentRole() == 'owner'
        || (userDoc(currentUid()).exists && userDoc(currentUid()).data.get('role', '') == 'owner')
      );
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          request.auth.token.get('admin', false) == true
          || currentRole() == 'admin'
          || (userDoc(currentUid()).exists && userDoc(currentUid()).data.get('role', '') == 'admin')
        );
    }

    function isTenant() {
      return isAuthenticated() && (
        currentRole() == 'tenant'
        || (userDoc(currentUid()).exists && userDoc(currentUid()).data.get('role', '') == 'tenant')
      );
    }

    function isVerified() {
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'phone'
        || request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function roleIsValid(role) {
      return role in ['owner', 'tenant'];
    }

    function userRoleUnchanged() {
      return (('role' in resource.data) && request.resource.data.role == resource.data.role)
        || (!('role' in resource.data)
          && request.resource.data.role == 'tenant');
    }

    function userUidUnchanged() {
      return (('uid' in resource.data) && request.resource.data.uid == resource.data.uid)
        || (!('uid' in resource.data)
          && request.resource.data.uid == currentUid());
    }

    function notificationsShapeIsValid(data) {
      return !('notifications' in data)
        || (
          data.notifications is map
          && (!('rent_due' in data.notifications) || data.notifications.rent_due is bool)
          && (!('payment_received' in data.notifications)
            || data.notifications.payment_received is bool)
        );
    }

    function tokenPlatformIsValid(platform) {
      return platform in ['android', 'ios', 'web', 'unknown'];
    }

    function deviceTokenShapeIsValid(data) {
      return data.token is string
        && data.token.size() > 20
        && data.token.size() < 4096
        && data.platform is string
        && tokenPlatformIsValid(data.platform)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('lastUsedAt' in data) || data.lastUsedAt is timestamp);
    }

    function ownerOwnsProperty(propertyId) {
      return exists(/databases/$(database)/documents/properties/$(propertyId))
        && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == currentUid();
    }

    function tenantOwnerImmutableFieldsUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.fullName == resource.data.fullName
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.email == resource.data.email
        && request.resource.data.idProofType == resource.data.idProofType
        && request.resource.data.idProofUrl == resource.data.idProofUrl
        && request.resource.data.agreementUrl == resource.data.agreementUrl
        && request.resource.data.additionalDocumentUrls == resource.data.additionalDocumentUrls;
    }

    function tenantTrustFieldsUnchanged() {
      return (
        (('trustScore' in resource.data) && request.resource.data.trustScore == resource.data.trustScore)
          || (!('trustScore' in resource.data) && !('trustScore' in request.resource.data))
      )
      && (
        (('trustBadge' in resource.data) && request.resource.data.trustBadge == resource.data.trustBadge)
          || (!('trustBadge' in resource.data) && !('trustBadge' in request.resource.data))
      );
    }

    function tenantCanSelfCreateProfile(tenantId) {
      return isTenant()
        && tenantId == currentUid()
        && request.resource.data.authUid == currentUid()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailLowercase is string
        && request.resource.data.name is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.ownerId == ''
        && request.resource.data.roomNumber is string
        && request.resource.data.dueAmount == 0
        && request.resource.data.totalPaid == 0
        && request.resource.data.isActive == false
        && request.resource.data.onboardingStatus == 'pending_assignment';
    }

    function tenantParentData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }

    function validIndianPhone(value) {
      return value is string
        && value.matches('^[6-9][0-9]{9}$');
    }

    // ===== FIRESTORE RULES =====

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        userId == currentUid()
        || (isTenant() && userDoc(userId).exists && userDoc(userId).data.get('role', '') == 'owner')
      );

      allow list: if isAuthenticated() &&
        request.query.limit <= 1;

      allow create: if isAuthenticated()
        && userId == currentUid()
        && (request.resource.data.get('uid', '') == currentUid() || request.resource.data.get('userId', '') == currentUid())
        && roleIsValid(request.resource.data.get('role', ''))
        && notificationsShapeIsValid(request.resource.data);

      allow update: if isAuthenticated()
        && userId == currentUid()
        && userUidUnchanged()
        && userRoleUnchanged()
        && notificationsShapeIsValid(request.resource.data);

      allow delete: if false;

      match /deviceTokens/{tokenId} {
        allow read: if isAuthenticated() && userId == currentUid();

        allow create: if isAuthenticated()
          && userId == currentUid()
          && deviceTokenShapeIsValid(request.resource.data);

        allow update: if isAuthenticated()
          && userId == currentUid()
          && deviceTokenShapeIsValid(request.resource.data)
          && request.resource.data.token == resource.data.token;

        allow delete: if isAuthenticated() && userId == currentUid();
      }

      match /notificationSnoozes/{snoozeId} {
        allow read, create, update, delete: if isAuthenticated() && userId == currentUid();
      }
    }

    match /owners_summary/{ownerId} {
      allow get: if isAuthenticated() && ownerId == currentUid();
      allow list: if isAuthenticated() && (ownerId == currentUid() || request.query.limit <= 1);

      allow create, update, delete: if false;
    }

    match /ownerTrustScoreLookupQuota/{docId} {
      allow read: if isAuthenticated() && resource.data.ownerId == currentUid();
      allow create, update, delete: if false;
    }

    match /ownerTrustScoreLookupEvents/{eventId} {
      allow read: if isAuthenticated() && resource.data.ownerId == currentUid();
      allow create, update, delete: if false;
    }

    match /tenantTrust/{phone} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    match /properties/{propertyId} {
      allow list: if isOwner();
      allow read: if isAuthenticated() && (
        resource.data.ownerId == currentUid()
        || resource.data.isPublished == true
        || (exists(/databases/$(database)/documents/tenants/$(currentUid())) && get(/databases/$(database)/documents/tenants/$(currentUid())).data.propertyId == propertyId)
      );

      allow create: if isOwner()
        && isVerified()
        && request.resource.data.ownerId == currentUid();

      allow update: if isOwner()
        && isVerified()
        && resource.data.ownerId == currentUid()
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isOwner()
        && isVerified()
        && resource.data.ownerId == currentUid();

      // Allow owners to query their own properties
      allow list: if isOwner() && request.query.ownerId == currentUid();
    }

    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (
          resource.data.ownerId == currentUid()
          || tenantId == currentUid()
          || (('authUid' in resource.data) && resource.data.authUid == currentUid())
          || (('email' in resource.data) && resource.data.email == request.auth.token.email)
        );

      allow create: if (
          isOwner()
          && isVerified()
          && request.resource.data.ownerId == currentUid()
          && ownerOwnsProperty(request.resource.data.propertyId)
        )
        || (tenantCanSelfCreateProfile(tenantId) && isVerified());

      allow update: if (
          isOwner()
          && isVerified()
          && resource.data.ownerId == currentUid()
          && request.resource.data.ownerId == resource.data.ownerId
          && ownerOwnsProperty(request.resource.data.propertyId)
          && tenantOwnerImmutableFieldsUnchanged()
          && tenantTrustFieldsUnchanged()
        )
        || (
          (tenantId == currentUid() || (('authUid' in resource.data) && resource.data.authUid == currentUid()))
          && isVerified()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.email == resource.data.email
          && request.resource.data.authUid == resource.data.authUid
        );

      allow delete: if isOwner() && isVerified() && (
        resource.data.ownerId == currentUid()
        || (
          ('propertyId' in resource.data)
          && ownerOwnsProperty(resource.data.propertyId)
        )
      );
    }

    match /tenants/{tenantId}/payments/{paymentId} {
      allow read: if isAuthenticated() && (
        tenantParentData(tenantId).ownerId == currentUid()
        || tenantId == currentUid()
      );

      // Legacy tenant subcollection payment writes are disabled.
      // Payments must be written by Cloud Functions (Admin SDK).
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/room_details/{docId} {
      allow read: if isAuthenticated() && (
        tenantParentData(tenantId).ownerId == currentUid()
        || tenantId == currentUid()
      );

      allow create, update: if (tenantId == currentUid() || (('authUid' in tenantParentData(tenantId)) && tenantParentData(tenantId).authUid == currentUid()))
        && docId == 'current'
        && request.resource.data.propertyName is string
        && request.resource.data.roomNumber is string
        && request.resource.data.monthlyRent is int
        && request.resource.data.monthlyRent > 0
        && request.resource.data.rentDueDay is int
        && request.resource.data.rentDueDay >= 1
        && request.resource.data.rentDueDay <= 31;

      allow delete: if false;
    }

    match /tenants/{tenantId}/owner_details/{docId} {
      allow read: if isAuthenticated() && (
        tenantParentData(tenantId).ownerId == currentUid()
        || tenantId == currentUid()
      );

      allow create, update: if (tenantId == currentUid() || (('authUid' in tenantParentData(tenantId)) && tenantParentData(tenantId).authUid == currentUid()))
        && docId == 'current'
        && validIndianPhone(request.resource.data.ownerPhoneNumber);

      allow delete: if false;
    }

    match /tenants/{tenantId}/reminders/{reminderId} {
      allow read: if isAuthenticated() && (
        tenantParentData(tenantId).ownerId == currentUid()
        || tenantId == currentUid()
      );

      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/documents/{docId} {
      allow read: if isAuthenticated() && (
        tenantParentData(tenantId).ownerId == currentUid()
        || tenantId == currentUid()
      );

      allow create: if (tenantId == currentUid() || (('authUid' in tenantParentData(tenantId)) && tenantParentData(tenantId).authUid == currentUid()))
        && request.resource.data.fileUrl is string
        && request.resource.data.publicId is string
        && request.resource.data.fileType in ['image', 'pdf']
        && request.resource.data.fileSizeBytes is int
        && (
          (request.resource.data.fileType == 'image' && request.resource.data.fileSizeBytes <= 200 * 1024)
          ||
          (request.resource.data.fileType == 'pdf' && request.resource.data.fileSizeBytes <= 500 * 1024)
        );

      allow update: if (tenantId == currentUid() || (('authUid' in tenantParentData(tenantId)) && tenantParentData(tenantId).authUid == currentUid()))
        && request.resource.data.fileUrl == resource.data.fileUrl
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.fileType == resource.data.fileType
        && request.resource.data.fileSizeBytes == resource.data.fileSizeBytes;

      allow delete: if (tenantId == currentUid() || (('authUid' in tenantParentData(tenantId)) && tenantParentData(tenantId).authUid == currentUid()));
    }

    match /tenants/{tenantId}/complaints/{complaintId} {
      allow read: if isAuthenticated() && (
        tenantParentData(tenantId).ownerId == currentUid()
        || tenantId == currentUid()
      );

      allow create: if (tenantId == currentUid() || (('authUid' in tenantParentData(tenantId)) && tenantParentData(tenantId).authUid == currentUid()))
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.status in ['pending', 'resolved'];

      allow update: if (tenantParentData(tenantId).ownerId == currentUid())
        && request.resource.data.description == resource.data.description
        && request.resource.data.category == resource.data.category
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.status in ['pending', 'resolved'];

      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow list: if isOwner() || isTenant();
      allow read: if isAuthenticated() && (
        resource.data.ownerId == currentUid()
        || resource.data.tenantId == currentUid()
      );

      // Payment writes are server-only via Cloud Functions (Admin SDK bypasses rules).
      allow create, update, delete: if false;

      // Allow owners and tenants to query their own payments
      allow list: if (isOwner() && request.query.ownerId == currentUid()) || (isTenant() && request.query.tenantId == currentUid());
    }

    match /appConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() && adminId == currentUid();
      allow write: if false;
    }

    match /user_images/{imageId} {
      allow read: if isAuthenticated() && resource.data.userId == currentUid();

      allow create: if isAuthenticated()
        && request.resource.data.userId == currentUid()
        && request.resource.data.imageUrl is string
        && request.resource.data.uploadedAt is timestamp;

      allow update: if isAuthenticated()
        && resource.data.userId == currentUid()
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isAuthenticated() && resource.data.userId == currentUid();
    }

    match /transactions/{transactionId} {
      allow read: if (isOwner() && resource.data.ownerId == currentUid())
        || (isTenant() && resource.data.tenantId == currentUid());
      allow write: if false;
    }

    match /leases/{leaseId} {
      allow read: if (isOwner() && resource.data.ownerId == currentUid())
        || (isTenant() && resource.data.tenantId == currentUid());
      allow write: if false;
    }

    match /messages/{messageId} {
      allow read: if (isOwner() && resource.data.ownerId == currentUid())
        || (isTenant() && resource.data.tenantId == currentUid());
      allow write: if false;
    }

    match /fcmTokens/{tokenId} {
      allow read, write: if false;
    }

    match /_webhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /_securitySignals/{signalId} {
      allow read, write: if false;
    }

    match /_securityAlerts/{alertId} {
      allow read, write: if false;
    }

    match /_notificationEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
